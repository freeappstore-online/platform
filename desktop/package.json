{
  "name": "freeappstore-desktop",
  "productName": "FreeAppStore",
  "version": "0.2.0",
  "private": true,
  "description": "FreeAppStore desktop app: runs FAS apps in their own windows and lets a local AI client use their tools through a loopback MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build && node scripts/build-info.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "dist:mac": "pnpm build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@freeappstore/sdk": "^0.21.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "kokoro-js": "1.2.1",
    "mp4-muxer": "5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.4"
  }
}
