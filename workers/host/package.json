{
  "name": "host",
  "version": "1.0.0",
  "description": "freeappstore-host — serves every published app from R2 via subdomain routing. Replaces the per-app CF Pages project model.",
  "scripts": {
    "test": "vitest run",
    "test:runtime": "vitest run --config vitest.runtime.mts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2"
    }
  }
}
