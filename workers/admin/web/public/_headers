# Security headers for every static asset the admin UI serves (#516). Workers
# static assets apply this file; /api/* is answered by the Worker (src/http.ts).
#
# The CSP is derived from what the built index.html and bundle load: the
# same-origin bundle, the PWA register script and service worker, one inline
# theme script (pinned by hash; src/test/headers.test.ts recomputes it from
# web/index.html), Google Fonts, the platform API for sign-in (/v1/auth/me),
# and avatars (GitHub or Google, so img-src stays https:).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-SMuJdOtjBJ9NJS2fchW2W0Rm4I45Xyvc+PC65B+H+2Q='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.freeappstore.online; worker-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
