    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "semver": "^7.8.6"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
