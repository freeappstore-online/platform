{
  "name": "freeappstore-agent",
  "private": true,
  "repository": "https://github.com/freeappstore-online/agent",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
