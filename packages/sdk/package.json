{
  "name": "@freeappstore/sdk",
  "version": "0.16.44",
  "description": "Browser SDK for FreeAppStore — auth, KV, collections, counters, rooms, proxy, encrypted user keys, roles, friends, email, push reminders, device-local persistence, validated backup and file export, React hooks, and UI components.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./push-sw": {
      "types": "./dist/push-sw.d.ts",
      "import": "./dist/push-sw.js"
    },
    "./pwa": {
      "types": "./dist/pwa.d.ts",
      "import": "./dist/pwa.js"
    },
    "./pwa-config": {
      "types": "./dist/pwa-config.d.ts",
      "import": "./dist/pwa-config.js"
    },
    "./persist": {
      "types": "./dist/persist/index.d.ts",
      "import": "./dist/persist/index.js"
    },
    "./backup": {
      "types": "./dist/backup/index.d.ts",
      "import": "./dist/backup/index.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    }
  },
  "homepage": "https://github.com/freeappstore-online/platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/platform.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/freeappstore-online/platform/issues"
  },
  "keywords": [
    "freeappstore",
    "sdk",
    "auth",
    "kv",
    "rooms",
    "websocket",
    "github-oauth",
    "cloudflare-workers",
    "proxy",
    "api-key"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backup-types.json",
    "test:backup-declarations": "pnpm build && tsc -p tsconfig.backup-declarations.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite-plugin-pwa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "sideEffects": false,
  "dependencies": {
    "idb": "^8.0.4"
  }
}
