// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`deployWorkflow (apps specifics) > matches the reviewed snapshot (bump deliberately) 1`] = `
"name: Deploy to R2

# Generated by @freeappstore/cli. Two jobs on purpose:
#   build  — runs the app's install/test/build plus the pinned validators.
#            No secrets here: a compromised npm package can only fail the build.
#   deploy — syncs the uploaded artifact to R2. Runs no project code (no
#            checkout, no install, no npx); only this job sees the R2 secrets.
# Regenerate with \`fas publish --update-workflow\`; do not add secrets to build.

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-\${{ github.repository }}
  cancel-in-progress: true

jobs:
  build:
    if: \${{ !startsWith(github.event.repository.name, 'template-') }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4.3.0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 22
      - name: Install
        run: |
          set -euo pipefail
          if [ ! -f pnpm-lock.yaml ]; then
            echo "Creating the first dependency lock for this app."
            pnpm install --no-frozen-lockfile
          else
            log=$(mktemp)
            if pnpm install --frozen-lockfile >"$log" 2>&1; then
              cat "$log"
            else
              status=$?
              cat "$log"
              if grep -q 'ERR_PNPM_OUTDATED_LOCKFILE' "$log"; then
                echo "Dependency manifests changed; updating the app lock deliberately."
                pnpm install --no-frozen-lockfile
              else
                rm "$log"
                exit "$status"
              fi
            fi
            rm "$log"
          fi
      # If your app uses VITE_* public config (OAuth client IDs, Firebase
      # config, etc.), add them as GitHub repo Variables and pass them to the
      # Build step. See https://freeappstore.online/skills.md "App Config & Secrets".
      # Example:
      #   env:
      #     VITE_GOOGLE_CLIENT_ID: \${{ vars.VITE_GOOGLE_CLIENT_ID }}
      - name: Resolve build target
        id: target
        run: npx --yes @freeappstore/cli@0.4.78 build-target --app-id "\${GITHUB_REPOSITORY##*/}" --github-output
      - name: Typecheck (when configured)
        run: pnpm run --if-present typecheck
      - name: Tests (when configured)
        run: pnpm run --if-present test
      - name: Build
        env:
          BUILD_COMMAND: \${{ steps.target.outputs.build-command }}
        run: bash -e -c "$BUILD_COMMAND"
      - name: Verify build output
        run: npx --yes @freeappstore/cli@0.4.78 build-target --artifact --app-id "\${GITHUB_REPOSITORY##*/}"
      - name: Retain verified dependency lock
        run: |
          set -euo pipefail
          test -f pnpm-lock.yaml
          git add -- pnpm-lock.yaml
          if ! git diff --cached --quiet -- pnpm-lock.yaml; then
            git config user.name "FreeAppStore dependency lock"
            git config user.email "dependency-lock@freeappstore.online"
            git commit -m "build: retain verified dependency resolution [skip ci]" -- pnpm-lock.yaml
            # A normal push rejects concurrent main changes; never overwrite newer app work.
            git push origin HEAD:main
          fi
          echo "Accepted source: $(git rev-parse HEAD)"
      # Code health scan — the JSON report + badge are published next to the
      # app so the console and store listings can show them. Never blocks.
      - name: Code health scan
        run: npx --yes @vibecodeqa/cli@0.57.0 --json --badge > /dev/null 2>&1 || true
      - name: Stage deploy artifact
        env:
          OUTPUT_PATH: \${{ steps.target.outputs.output-path }}
        run: |
          rm -rf .fas-deploy
          mkdir -p .fas-deploy/app .fas-deploy/code-health
          cp -R "$OUTPUT_PATH"/. .fas-deploy/app/
          test -n "$(ls -A .fas-deploy/app)" || { echo "::error::$OUTPUT_PATH is empty"; exit 1; }
          for f in report.json badge.svg; do
            if [ -f ".vibe-check/$f" ]; then cp ".vibe-check/$f" .fas-deploy/code-health/; fi
          done
      - name: Upload deploy artifact
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: deploy
          path: .fas-deploy
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 1

  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Download deploy artifact
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: deploy
          path: .fas-deploy
      - name: Upload to R2
        env:
          AWS_ACCESS_KEY_ID: \${{ secrets.R2_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: \${{ secrets.R2_SECRET_ACCESS_KEY }}
          AWS_DEFAULT_REGION: auto
          R2_ACCOUNT_ID: \${{ secrets.R2_ACCOUNT_ID }}
        run: |
          test -n "$(ls -A .fas-deploy/app)" || { echo "::error::deploy artifact is empty"; exit 1; }
          aws s3 sync .fas-deploy/app "s3://fas-apps/apps/\${GITHUB_REPOSITORY##*/}/" \\
            --endpoint-url "https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com" \\
            --delete \\
            --no-progress
          echo "Deployed apps/\${GITHUB_REPOSITORY##*/} from \${GITHUB_SHA::7} to R2"

      - name: Upload code health
        env:
          AWS_ACCESS_KEY_ID: \${{ secrets.R2_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: \${{ secrets.R2_SECRET_ACCESS_KEY }}
          AWS_DEFAULT_REGION: auto
          R2_ACCOUNT_ID: \${{ secrets.R2_ACCOUNT_ID }}
        run: |
          EP="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
          PREFIX="s3://fas-apps/apps/\${GITHUB_REPOSITORY##*/}/.vcqa"
          if [ -f .fas-deploy/code-health/report.json ]; then
            aws s3 cp .fas-deploy/code-health/report.json "$PREFIX/report.json" \\
              --endpoint-url "$EP" --content-type application/json --no-progress
          fi
          if [ -f .fas-deploy/code-health/badge.svg ]; then
            aws s3 cp .fas-deploy/code-health/badge.svg "$PREFIX/badge.svg" \\
              --endpoint-url "$EP" --content-type image/svg+xml --no-progress
          fi
"
`;

exports[`deployWorkflow (games specifics) > matches the reviewed snapshot (bump deliberately) 1`] = `
"name: Deploy to R2

# Generated by @freeappstore/cli. Two jobs on purpose:
#   build  — runs the app's install/test/build plus the pinned validators.
#            No secrets here: a compromised npm package can only fail the build.
#   deploy — syncs the uploaded artifact to R2. Runs no project code (no
#            checkout, no install, no npx); only this job sees the R2 secrets.
# Regenerate with \`fas publish --update-workflow\`; do not add secrets to build.

on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-\${{ github.repository }}
  cancel-in-progress: true

jobs:
  build:
    if: \${{ !startsWith(github.event.repository.name, 'template-') }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4.3.0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 22
      - name: Install
        run: pnpm install --no-frozen-lockfile
      - name: Build
        run: pnpm build
      - name: Verify build output
        run: |
          test -d ./web/dist || { echo "::error::No build output at web/dist"; exit 1; }
          test -n "$(ls -A ./web/dist)" || { echo "::error::web/dist is empty"; exit 1; }
      - name: Stage deploy artifact
        run: |
          rm -rf .fas-deploy
          mkdir -p .fas-deploy
          cp -R ./web/dist .fas-deploy/app
      - name: Upload deploy artifact
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: deploy
          path: .fas-deploy
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 1

  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Download deploy artifact
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: deploy
          path: .fas-deploy
      - name: Upload to R2
        env:
          AWS_ACCESS_KEY_ID: \${{ secrets.R2_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: \${{ secrets.R2_SECRET_ACCESS_KEY }}
          AWS_DEFAULT_REGION: auto
          R2_ACCOUNT_ID: \${{ secrets.R2_ACCOUNT_ID }}
        run: |
          test -n "$(ls -A .fas-deploy/app)" || { echo "::error::deploy artifact is empty"; exit 1; }
          aws s3 sync .fas-deploy/app "s3://fgs-games/games/\${GITHUB_REPOSITORY##*/}/" \\
            --endpoint-url "https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com" \\
            --delete \\
            --no-progress
          echo "Deployed games/\${GITHUB_REPOSITORY##*/} from \${GITHUB_SHA::7} to R2"
"
`;
