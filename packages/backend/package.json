{
  "name": "@freeappstore/backend",
  "version": "0.0.0",
  "description": "Cloudflare Worker powering @freeappstore/sdk — auth, KV, Durable-Object rooms.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fas --local",
    "db:migrate:prod": "wrangler d1 migrations apply fas --remote"
  },
  "dependencies": {
    "@freeappstore/compliance": "workspace:*",
    "arctic": "^3.7.0",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
