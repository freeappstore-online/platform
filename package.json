{
  "name": "freeappstore-platform-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Free SDK + CLI + backend for apps published on freeappstore.online",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/platform.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:backend": "pnpm --filter @freeappstore/backend dev",
    "deploy:backend": "pnpm --filter @freeappstore/backend deploy",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
